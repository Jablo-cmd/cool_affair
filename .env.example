# The Cool Affair Universe: environment variables
# Copy to .env.local for local development. Never commit real values.
# Every variable is optional: without Supabase the public site renders its
# built-in content and the Studio shows setup instructions.

# Public URL of the site, used for canonical URLs, the sitemap and social cards.
# e.g. https://www.example.com (no trailing slash). Falls back to the Vercel
# production URL, then http://localhost:3000.
NEXT_PUBLIC_SITE_URL=

# Supabase project (project ref: adhppvuwbrnwujziedzj)
# Dashboard → Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=https://adhppvuwbrnwujziedzj.supabase.co
# The publishable (or legacy "anon") key. It is safe in the browser because
# Row Level Security protects the data.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# NOT used by the app. Never put the service-role / secret key in any
# NEXT_PUBLIC_ variable or commit it. It is only needed to run
# `npm run test:rls` against a LOCAL Supabase stack.
# SUPABASE_URL=http://127.0.0.1:54321
# SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
